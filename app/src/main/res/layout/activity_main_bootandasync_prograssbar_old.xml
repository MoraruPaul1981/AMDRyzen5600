<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout_async_prograsser"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="left"
    android:backgroundTint="@color/cardview_light_background"
    tools:context=".BusinessLogicForApps.BootAndAsync.View.MainActivityBootAndAsync">



    <RelativeLayout
        android:id="@+id/containersetting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:visibility="visible">
        <ImageView
            android:id="@+id/imageView_faceapp_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@+id/waveHeader"
            android:adjustViewBounds="false"
            android:layout_alignParentRight="true"
            android:visibility="visible"
            android:layout_margin="5dp"
            android:padding="5dp"
            app:srcCompat="@drawable/icon_setting_bootactivitu" />


        <com.scwang.wave.MultiWaveHeader
            android:id="@+id/waveHeader"
            android:layout_alignParentTop="true"
            android:layout_width="match_parent"
            app:mwhStartColor="@color/colorPrimary"
            app:mwhCloseColor="@color/color_beliyi"
            app:mwhWaves="MultiWave"
            app:mwhWaveHeight="50dp"
            app:mwhColorAlpha="0.45"
            android:layout_height="90dp"/>




        <TextView
            android:id="@+id/organ"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:text="ООО «Союз Автодор»"
            android:textAlignment="center"
            android:textColor="#0C0A0A"
            android:layout_above="@+id/organyeaer"
            android:layout_centerHorizontal="true"
            android:textStyle="bold"
            android:textSize="14sp" />


        <TextView
            android:id="@+id/organyeaer"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:text="2025 г."
            android:textAlignment="center"
            android:textColor="#0C0A0A"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:textStyle="bold"
            android:textSize="13sp" />



        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:shrinkColumns="*"
            android:stretchColumns="*">


            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|center_horizontal">

                <RelativeLayout
                    android:id="@+id/container1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/imageviewbootlogo"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_centerHorizontal="true"
                        android:layout_margin="10dp"
                        android:adjustViewBounds="false"
                        android:padding="5dp"
                        android:visibility="visible"
                        app:srcCompat="@mipmap/deliverytruckblack" />
                </RelativeLayout>
            </TableRow>


            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|center_horizontal">

                <RelativeLayout
                    android:id="@+id/container2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:visibility="visible">

                    <ProgressBar
                        android:id="@+id/progressbarbootandasync"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_margin="10dp"
                        android:layout_marginBottom="60dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/colorPrimary"
                        android:progress="0"
                        android:scaleY="1"
                        android:visibility="visible" />
                </RelativeLayout>
            </TableRow>


            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/disayn_line_tablerow30"
                android:gravity="center_vertical|center_horizontal">

            </TableRow>


        </TableLayout>


    </RelativeLayout>



<!--//TODO Начало Основного Экрана Boot Screen -->


    <!--TODO НАчало Боллоковой Панели-->

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigator_asyncapp"
        android:layout_width="70dp"
        android:background="@drawable/dialog_bg_dashbord_bokobvay_panel_up_grey"
        android:layout_gravity="left|center"
        android:layout_height="600dp"
        android:layout_margin="5dp"
        android:layout_marginRight="5dp"
        android:fitsSystemWindows="true"
        app:itemIconSize="25dp"
        app:itemIconTint="#E7EDED"
        android:visibility="visible"
        app:cardElevation="20dp"
        app:cardMaxElevation="10dp"
        android:translationZ="50dp"
        android:foregroundGravity="center"
        app:itemBackground="@drawable/dialog_bg_dashbord_bokobvay_panel_grey_navigarotbar"
        app:itemTextColor="@color/cardview_dark_background"
        app:menu="@menu/menu_for_asynsapp_navigationview"
        tools:ignore="ExtraText">

    </com.google.android.material.navigation.NavigationView>











</androidx.drawerlayout.widget.DrawerLayout>
