<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="bottom"
    android:foregroundGravity="top"
    android:layout_gravity="center"
    android:layout_alignParentBottom="true"
    android:layout_alignParentTop="true"
    android:baselineAligned="true"
    android:divider="@color/accent"
    android:measureWithLargestChild="true"
    tools:context=".TabelsApp.Tabel.New.MainActivityNewTabels"
    android:orientation="vertical">




    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialcardviewrow0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:padding="2dp"
        android:animateLayoutChanges="true"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:translationZ="4dp"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:cardCornerRadius="5dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:strokeWidth="1dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:padding="2dp">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonbackarrow"
                android:layout_width="43dp"
                android:layout_height="55dp"
                android:layout_column="0"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:backgroundTint="#F1F4F4"
                android:fontFamily="@font/alegreya_sans_sc_thin"
                android:gravity="center"
                android:padding="1dp"
                android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                android:textAlignment="center"
                android:translationZ="5dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardMaxElevation="20dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/icon_back_tabelcustomer_arrow"
                app:iconGravity="textEnd"
                app:iconPadding="1dp"
                app:iconSize="20dp"
                app:iconTint="#909393"
                app:rippleColor="#F50057"
                app:strokeColor="#E0E0E3"
                app:strokeWidth="1dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/textView3СловоТабель"
                style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_margin="1dp"
                android:bufferType="normal"
                android:fontFamily="sans-serif-light"
                android:foregroundGravity="center"
                android:gravity="center"
                android:padding="1dp"
                android:text="Новый Табель"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="#0E0E0E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:theme="@style/Theme.AppCompat.DayNight"
                android:typeface="serif" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>





    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:foregroundGravity="center"
        android:fillViewport="true"
        android:scrollbars="horizontal|vertical"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll"
        android:scrollbarThumbVertical="@color/divider"
        android:orientation="vertical"
        android:scrollbarStyle="outsideInset"
        android:outlineAmbientShadowColor="@color/actionbar_text_color">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialcardviewrow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:padding="2dp"
            android:animateLayoutChanges="true"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:translationZ="4dp"
            app:cardBackgroundColor="@color/actionbar_text_color"
            app:cardCornerRadius="5dp"
            app:cardElevation="2dp"
            app:cardMaxElevation="1dp"
            app:strokeColor="@color/icon_dashdornd_tabel2_background"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="580dp"
                android:foregroundGravity="top"
                android:layout_gravity="top|center"
                android:gravity="top|center"
                android:baselineAligned="true"
                android:dividerPadding="@dimen/car_ui_padding_5"
                android:divider="@color/accent"
                android:measureWithLargestChild="true"
                android:orientation="vertical">

                <!-- //TODO code core new tabel-->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textviewnamecfo"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="120dp"
                    android:padding="2dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@drawable/style_for_templates"
                    android:hint="Цфо"
                    android:textColor="#00E5FF"
                    android:textColorHint="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:translationZ="5dp"
                    android:visibility="visible"
                    app:cardCornerRadius="1dp"
                    app:cardElevation="1dp"
                    tools:ignore="MissingConstraints" />


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/materialspiritnew_tabel"
                    android:layout_width="330dp"
                    android:layout_height="45dp"
                    android:minHeight="40dp"
                    android:layout_margin="10dp"
                    android:padding="2dp"
                    android:background="@drawable/style_for_templates2"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textAlignment="gravity"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:visibility="visible"
                    android:hint="Выберете цфо"
                    android:textColorHint="#80807C" />






                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textviewdate"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:padding="2dp"
                    android:layout_marginTop="80dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@drawable/style_for_templates"
                    android:hint="Дата"
                    android:textColor="#00E5FF"
                    android:textColorHint="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:translationZ="5dp"
                    android:visibility="visible"
                    app:cardCornerRadius="1dp"
                    app:cardElevation="1dp" />


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/ЗначениеДатаСоздаваемогоТабеля"
                    android:layout_width="330dp"
                    android:layout_height="45dp"
                    android:layout_margin="10dp"
                    android:padding="2dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@drawable/style_for_templates2"
                    android:textAlignment="gravity"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    android:hint="Выберете дату"
                    android:textColorHint="#80807C" />





            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>




    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialcardviewrow3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:padding="2dp"
        android:animateLayoutChanges="true"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:translationZ="4dp"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:cardCornerRadius="5dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:visibility="visible"
            android:foregroundGravity="top"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:layout_alignParentBottom="true"
            android:layout_alignParentTop="true"
            android:baselineAligned="true"
            android:divider="@color/accent"
            android:measureWithLargestChild="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/КнопкаСозданиеНовогоТабеля"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton.Icon"
                android:layout_width="164dp"
                android:layout_height="40dp"
                android:layout_margin="10dp"
                android:padding="10dp"
                android:backgroundTint="#FFFFFF"
                android:background="@drawable/style_for_assitiionmatrial_create_name2"
                android:backgroundTintMode="screen"
                android:focusable="auto"
                android:fontFamily="sans-serif-medium"
                android:foregroundGravity="center"
                android:gravity="center"
                android:layout_gravity="center"
                android:text="Создать"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="#0E0E0E"
                android:textColorHint="#0E0E0E"
                android:textSize="11dp"
                android:textStyle="bold"
                android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
                android:visibility="visible"
                app:backgroundTint="@color/divider"
                app:cornerRadius="20dp"
                app:iconTint="#8A3C3C"
                tools:visibility="visible" />




        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>



</LinearLayout>




