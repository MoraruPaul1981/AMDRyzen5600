<LinearLayout
    android:id="@+id/activitymetkitabels"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:layout_gravity="center"
    android:gravity="top"
    android:layout_margin="2dp"
    android:padding="2dp"
    android:foregroundGravity="center"
    tools:context=".TabelsApp.Tabel.Single.view.MainActivity_Metki_Tabel"
    android:orientation="vertical">






    <com.google.android.material.textview.MaterialTextView
        android:id="@android:id/text1"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="@drawable/style_for_templates4"
        android:checkMark="?android:attr/listChoiceIndicatorSingle"
        android:layout_gravity="center"
        android:gravity="center"
        android:minHeight="50dp"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        android:layout_marginTop="5dp"
        android:padding="2dp"
        android:hint="метки"
        android:textStyle="normal"
        android:textColor="@color/colorPrimary"
        android:textSize="17dp"
        android:translationZ="10dp"
        app:cardCornerRadius="3dp"
        app:cardElevation="1dp"
        app:cardMaxElevation="5dp"
        app:cornerRadius="10dp"
        android:icon="@drawable/brograssbarnews4"
        app:strokeWidth="0dp">
    </com.google.android.material.textview.MaterialTextView>





    <com.google.android.material.textview.MaterialTextView
        android:id="@android:id/text2"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@drawable/style_for_templates3"
        android:checkMark="?android:attr/listChoiceIndicatorSingle"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:padding="2dp"
        android:minHeight="50dp"
        android:hint="описание "
        android:textStyle="normal"
        android:textColor="@color/colorPrimary"
        android:textSize="15dp"
        android:translationZ="10dp"
        app:cardCornerRadius="3dp"
        app:cardElevation="1dp"
        app:cardMaxElevation="5dp"
        app:cornerRadius="10dp"
        android:icon="@drawable/brograssbarnews4"
        app:strokeWidth="0dp">
    </com.google.android.material.textview.MaterialTextView>
</LinearLayout>











