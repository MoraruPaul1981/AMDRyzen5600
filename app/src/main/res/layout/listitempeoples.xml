<LinearLayout
    android:id="@android:id/text1"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="left|top"
    android:foregroundGravity="top"
    android:layout_gravity="top"
    android:baselineAligned="true"
    android:background="#F6F2F2"
    tools:context=".TabelsApp.Peoples.MainActivityListPeoples"
    android:orientation="vertical">


     <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_gravity="center"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
         app:cardBackgroundColor="@color/actionbar_text_color"
        android:translationZ="1dp"
        android:animateLayoutChanges="true"
        android:layout_margin="5dp"
        android:padding="1dp"
         android:foreground="?android:attr/selectableItemBackground"
         android:orientation="vertical"
         app:strokeColor="@color/accent"
         app:strokeWidth="3dp">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left|top"
        android:foregroundGravity="top"
        android:layout_gravity="center"
        android:baselineAligned="true"
        android:divider="@color/accent"
        android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ImageViewPeoples"
                                android:layout_width="30dp"
                                android:layout_height="60dp"
                                android:layout_margin="5dp"
                                android:padding="2dp"
                                android:animateLayoutChanges="true"
                                android:gravity="center"
                                android:visibility="visible"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="10dp"
                                app:srcCompat="@drawable/icon_for_eople_listtabel1"
                                app:strokeColor="#F5FFFA" />


                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/MaterialTextViewPeoples"
                                    android:layout_weight="1"
                                    android:layout_width="250dp"
                                    android:layout_height="60dp"
                                    android:layout_margin="5dp"
                                    android:padding="2dp"
                                    android:animateLayoutChanges="true"
                                    android:checkMark="?android:attr/textCheckMark"
                                    android:foregroundGravity="center"
                                    android:gravity="center"
                                    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                                    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
                                    android:text="фио"
                                    android:textAlignment="gravity"
                                    android:textAppearance="?android:attr/textAppearanceListItemSmall"
                                    android:textColor="#000000"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:visibility="visible"
                                    app:cardCornerRadius="20dp"
                                    app:cardElevation="10dp"
                                    app:strokeColor="#F5FFFA" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/MaterialTextViewPeopeChasys"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="5dp"
        android:padding="2dp"
        android:animateLayoutChanges="true"
        android:checkMark="?android:attr/textCheckMark"
        android:foregroundGravity="center"
        android:gravity="center"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:text="час"
        android:textAlignment="gravity"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textColor="#000000"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cardCornerRadius="20dp"
        android:tooltipText="смена"
        app:cardElevation="10dp"
        app:strokeColor="#F5FFFA" />


</LinearLayout>
     </androidx.cardview.widget.CardView>
</LinearLayout>












