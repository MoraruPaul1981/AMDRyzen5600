<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@android:id/text1"
xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
android:layout_height="wrap_content"
    android:background="@drawable/style_for_assitiionmatrial_create_name7"
android:orientation="horizontal">



                        <ImageView
                            android:id="@+id/ImageViewIemTabel"
                            android:layout_width="35dp"
                            android:layout_height="wrap_content"
                            android:minHeight="110dp"
                            android:background="@drawable/style_for_assitiionmatrial_create_name6"
                            android:animateLayoutChanges="true"
                            android:gravity="top|left"
                            android:layout_gravity="top"
                            android:visibility="visible"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="1dp"
                            android:layout_margin="3dp"
                            android:padding="1dp"
                            app:srcCompat="@drawable/icon_newlisttabel"
                            app:strokeColor="#F5FFFA" />



                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/MaterialTextViewItemTabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="110dp"
                            android:checkMark="?android:attr/textCheckMark"
                            android:foregroundGravity="center"
                            android:gravity="center"
                            android:layout_gravity="top"
                            android:layout_weight="1"
                            android:layout_margin="3dp"
                            android:padding="1dp"
                            android:background="@drawable/style_for_assitiionmatrial_create_name6"
                            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                            android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
                            android:text="цфо"
                            android:textAlignment="center"
                            android:textAppearance="?android:attr/textAppearanceListItemSmall"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="10dp"
                            app:strokeColor="#F5FFFA"
                            android:animateLayoutChanges="true"
                            app:cardMaxElevation="5dp"
                            app:strokeWidth="1dp"
                            android:visibility="visible"/>


                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/MaterialTextViewCount"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:minHeight="110dp"
                            android:layout_gravity="top|right"
                            android:gravity="center"
                            android:animateLayoutChanges="true"
                            android:background="@drawable/style_for_assitiionmatrial_create_name6"
                            android:checkMark="?android:attr/textCheckMark"
                            android:foregroundGravity="center"
                            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                            android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
                            android:hint="()"
                            android:layout_margin="3dp"
                            android:padding="1dp"
                            android:textAlignment="gravity"
                            android:textAppearance="?android:attr/textAppearanceListItemSmall"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="visible"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="10dp"
                            app:cardMaxElevation="5dp"
                            app:strokeColor="#F5FFFA"
                            app:strokeWidth="1dp" />

</LinearLayout>




