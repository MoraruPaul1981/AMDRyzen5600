<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/relativelayoutshabloni"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="5"
    android:padding="5dp"
    android:orientation="vertical">

    <!--//TODO ROW 1-->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:cardCornerRadius="5dp"
        android:layout_margin="5dp"
        android:padding="2dp"

        android:layout_weight="1"


        android:gravity="top"
        android:layout_gravity="center"

        android:animateLayoutChanges="true"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        android:translationZ="4dp"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:padding="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/imageViewСтрелкаВнутриТабеля"
                android:layout_width="43dp"
                android:layout_height="55dp"
                android:layout_column="0"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_margin="3dp"
                android:backgroundTint="#F1F4F4"
                android:fontFamily="@font/alegreya_sans_sc_thin"
                android:gravity="center"
                android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                android:textAlignment="center"
                android:translationZ="5dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardMaxElevation="20dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/icon_back_tabelcustomer_arrow"
                app:iconGravity="textEnd"
                app:iconPadding="1dp"
                app:iconSize="20dp"
                app:iconTint="#909393"
                app:rippleColor="#F50057"
                app:strokeColor="#E0E0E3"
                app:strokeWidth="1dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/textView3СловоТабель"
                style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_margin="3dp"
                android:bufferType="normal"
                android:fontFamily="sans-serif-light"
                android:foregroundGravity="center"
                android:gravity="center"
                android:text="Шаблоны"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="#0E0E0E"
                android:textSize="17sp"
                android:textStyle="bold"
                android:theme="@style/Theme.AppCompat.DayNight"
                android:typeface="serif" />

            <TextView
                android:id="@+id/textviewcountcustomer"
                style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_margin="3dp"
                android:bufferType="normal"
                android:fontFamily="sans-serif-light"
                android:foregroundGravity="center"
                android:gravity="center|fill_horizontal"
                android:hint="кол:"
                android:text="кол:"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="#0E0E0E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:theme="@style/Theme.AppCompat.DayNight"
                android:typeface="serif" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>


    <!--//TODO ROW 2-->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="5dp"
        android:layout_margin="5dp"
        android:padding="2dp"

        android:layout_weight="3"

        android:gravity="center"
        android:layout_gravity="center"

        android:animateLayoutChanges="true"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        android:translationZ="4dp"
        app:strokeWidth="1dp">
            <GridView
                android:id="@+id/gridviewtemplates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_margin="2dp"
                android:padding="2dp"
                android:minWidth="250dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:horizontalSpacing="5dp"
                android:stretchMode="columnWidth"
                android:numColumns="1"
                android:foregroundGravity="center"
                android:textAlignment="center"
                android:verticalSpacing="30dp"
                android:scrollIndicators="left|right"
                android:scrollbars="horizontal|vertical"
                tools:ignore="MissingConstraints"/>
    </com.google.android.material.card.MaterialCardView>





    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:cardCornerRadius="5dp"
        android:layout_margin="5dp"
        android:padding="2dp"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:animateLayoutChanges="true"
        app:cardBackgroundColor="@color/color_beliyi"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        android:translationZ="4dp"
        app:strokeWidth="1dp">
        <RelativeLayout
            android:layout_margin="2dp"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <!--  todo кнопка для сохранения-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bottom_alaliz_and_dwonloadupdatepo"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton.Icon"
                android:layout_width="220dp"
                android:layout_height="60dp"
                android:layout_centerHorizontal  ="true"
                android:gravity="center"
                android:text="Загрузить"
                android:layout_margin="5dp"
                android:layout_centerInParent="true"
                android:backgroundTint="#797C7C"
                android:backgroundTintMode="screen"
                android:textColor="#0E0E0E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:translationZ="150dp"
                android:visibility="visible"
                app:cornerRadius="20dp"
                tools:visibility="visible" />

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>










</LinearLayout>