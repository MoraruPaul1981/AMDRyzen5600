<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layouttemplates"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/icon_dashdornd_tabel2_background"
    app:layout_scrollFlags="snapMargins|scroll|enterAlways|enterAlwaysCollapsed|exitUntilCollapsed|snap"
    tools:context=".TabelsApp.Templates.view.MainActivityListTemplates"
    tools:visibility="visible">



    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardfinddirectory_row1"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:cardCornerRadius="5dp"
        android:layout_margin="5dp"
        android:padding="2dp"
        android:animateLayoutChanges="true"
        android:layout_alignParentTop="true"
        android:gravity="center"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        android:translationZ="4dp"
        app:strokeWidth="1dp"
        tools:ignore="MissingConstraints">



        <RelativeLayout
            android:layout_margin="2dp"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonexit"
                android:layout_column="0"
                android:layout_width="43dp"
                android:layout_height="55dp"
                android:backgroundTint="#F1F4F4"
                android:gravity="center"
                android:fontFamily="@font/alegreya_sans_sc_thin"
                android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:padding="2dp"
                android:layout_margin="2dp"
                android:textAlignment="center"
                app:cornerRadius="20dp"
                app:icon="@drawable/icon_back_tabelcustomer_arrow"
                app:iconGravity="textEnd"
                app:iconPadding="1dp"
                app:iconSize="20dp"
                app:iconTint="#909393"
                app:rippleColor="#F50057"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E3"
                app:cardMaxElevation="20dp"
                app:strokeWidth="1dp"
                android:translationZ="5dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/textView3СловоТабель"
                style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:layout_margin="2dp"
                android:textAlignment="center"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:bufferType="normal"
                android:fontFamily="sans-serif-light"
                android:foregroundGravity="center"
                android:gravity="center"
                android:text="Шаблоны"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="#0E0E0E"
                android:textSize="17sp"
                android:textStyle="bold"
                android:theme="@style/Theme.AppCompat.DayNight"
                android:typeface="serif" />


            <TextView
                android:id="@+id/textviewcountemplates"
                style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                android:layout_width="85dp"
                android:layout_height="40dp"
                android:padding="2dp"
                android:layout_marginLeft="60dp"
                android:layout_marginRight="10dp"
                android:textAlignment="center"
                android:layout_alignParentRight="true"
                android:layout_toRightOf ="@+id/textView3СловоТабель"
                android:layout_centerVertical="true"
                android:bufferType="normal"
                android:fontFamily="sans-serif-light"
                android:foregroundGravity="center"
                android:gravity="center"
                android:text="()"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="#0E0E0E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:theme="@style/Theme.AppCompat.DayNight"
                android:typeface="serif" />



        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>







    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardfinddirectory_row2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginLeft="5dp"
        android:padding="2dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/cardfinddirectory_row1"
        android:layout_above="@+id/cardfinddirectory_row3"
        android:animateLayoutChanges="true"
        android:gravity="center"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:cardElevation="2dp"
        app:cardMaxElevation="5dp"
        android:translationZ="4dp"
        app:strokeWidth="1dp"
        tools:ignore="MissingConstraints">


        <RelativeLayout
            android:layout_margin="2dp"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <ScrollView
                android:id="@+id/scrollviewcompletetemplates"
                android:layout_width="match_parent"
                android:layout_height="550dp"
                android:fillViewport="true"
                android:scrollbars="horizontal|vertical"
                android:stackFromBottom="true"
                android:transcriptMode="alwaysScroll"
                android:layout_gravity="center"
                android:foregroundGravity="center"
                android:scrollbarThumbVertical="@color/divider"
                android:outlineAmbientShadowColor="@color/actionbar_text_color">

                <ListView
                    android:id="@+id/listcompletetemplates"
                    android:layout_width="match_parent"
                    android:layout_height="600dp"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTintMode="multiply"
                    android:layout_alignParentTop="true"
                    android:choiceMode="multipleChoice"
                    android:layerType="software"
                    android:orientation="vertical"
                    android:scrollbars="horizontal|vertical"
                    android:textAlignment="center"
                    android:textDirection="firstStrong"
                    android:textSize="26dp"
                    android:visibility="visible" />
            </ScrollView>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>





    <!--       &#45;&#45;TODO нижний блок -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardfinddirectory_row3"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:cardCornerRadius="5dp"
        android:layout_margin="5dp"
        android:padding="2dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:animateLayoutChanges="true"
        android:gravity="center"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        android:translationZ="4dp"
        app:strokeWidth="1dp"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:layout_margin="2dp"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



            <EditText
                android:id="@+id/editTextnamenewtempelates"
                android:layout_width="350dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:padding="2dp"
                android:hint="Название нового шаблона..."
                android:textColorHighlight="@color/primary_dark"
                android:inputType="textPersonName|textCapWords"
                android:textAlignment="center"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:textColor="#0E0E0E"
                android:textColorHint="#FFD5D9DA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/style_forpolymaterialb_cycle_createspinner41"
                android:visibility="visible"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonnewtemplate"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:layout_marginBottom="2dp"
                android:padding="2dp"
                android:backgroundTint="#FFD5D9DA"
                android:backgroundTintMode="screen"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:gravity="center|end"
                android:text="Создать"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="#0E0E0E"
                android:textColorHint="#F50057"
                android:textSize="12sp"
                android:visibility="visible"
                app:iconTint="#8A3C3C"
                app:cornerRadius="25dp"/>

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>













</RelativeLayout>