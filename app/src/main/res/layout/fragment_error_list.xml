<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearerrorfragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:visibility="visible"
    android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
    tools:context=".TabelsApp.Peoples.MainActivityListPeoples">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="3dp"
        app:cardElevation="10dp"
        app:cardMaxElevation="10dp"
        app:strokeWidth="1dp"
        android:translationZ="2dp"
        android:animateLayoutChanges="true"
        app:cardBackgroundColor="@color/divider"
        app:strokeColor="#FFFFFF">



        <TableLayout
            android:shrinkColumns="*"
            android:stretchColumns="0"
            android:collapseColumns="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="top"
            android:layout_margin="1dp"
            android:padding="1dp"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center">


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_margin="2dp"
                    android:animateLayoutChanges="true"
                    android:gravity="center"
                    android:padding="2dp"
                    android:translationZ="4dp"
                    app:cardBackgroundColor="@color/actionbar_text_color"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="2dp"
                    app:cardMaxElevation="1dp"
                    app:strokeColor="@color/icon_dashdornd_tabel2_background"
                    app:strokeWidth="1dp">


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="2dp"
                        android:padding="2dp">


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/imageViewBack"
                            android:layout_width="43dp"
                            android:layout_height="55dp"
                            android:layout_column="0"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            android:layout_margin="1dp"
                            android:backgroundTint="#F1F4F4"
                            android:fontFamily="@font/alegreya_sans_sc_thin"
                            android:gravity="center"
                            android:padding="1dp"
                            android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                            android:textAlignment="center"
                            android:translationZ="5dp"
                            app:cardCornerRadius="5dp"
                            app:cardElevation="2dp"
                            app:cardMaxElevation="20dp"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/icon_back_tabelcustomer_arrow"
                            app:iconGravity="textEnd"
                            app:iconPadding="1dp"
                            app:iconSize="20dp"
                            app:iconTint="#909393"
                            app:rippleColor="#F50057"
                            app:strokeColor="#E0E0E3"
                            app:strokeWidth="1dp"
                            tools:ignore="SpeakableTextPresentCheck" />

                        <TextView
                            android:id="@+id/textView3СловоТабель"
                            style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:layout_margin="1dp"
                            android:bufferType="normal"
                            android:fontFamily="sans-serif-light"
                            android:foregroundGravity="center"
                            android:gravity="center"
                            android:padding="1dp"
                            android:text="Ошибки"
                            android:textAlignment="center"
                            android:textAllCaps="false"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                            android:textColor="#0E0E0E"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:theme="@style/Theme.AppCompat.DayNight"
                            android:typeface="serif" />


                    </RelativeLayout>

                </com.google.android.material.card.MaterialCardView>

            </TableRow>




            <!-- //TODO сам лист -->

            <TableRow android:id="@+id/tablerow3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/materialcardViewrowscroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="5dp"
                       android:layout_margin="3dp"
                        android:padding="2dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:layout_above="@+id/materialcardViewbutoonerror"
                        android:animateLayoutChanges="true"
                        android:gravity="center"
                        app:strokeColor="@color/icon_dashdornd_tabel2_background"
                        app:cardBackgroundColor="@color/actionbar_text_color"
                        app:cardElevation="2dp"
                        app:cardMaxElevation="1dp"
                        android:translationZ="4dp"
                        app:strokeWidth="1dp">
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="2dp"
                            android:padding="1dp"
                            android:fillViewport="true"
                            android:scrollbars="horizontal|vertical"
                            android:stackFromBottom="true"
                            android:transcriptMode="alwaysScroll"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/disayn_line_tablerow5">

                            <TextView
                                android:id="@+id/textViewAllError"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:padding="2dp"
                                android:gravity="center"
                                android:hint="Данные..."
                                android:orientation="vertical"
                                android:overScrollMode="always"
                                android:scrollbars="horizontal|vertical"
                                android:textColor="#5B6161"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:visibility="visible"/>


                        </ScrollView>
                    </com.google.android.material.card.MaterialCardView>





                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/materialcardViewbutoonerror"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        app:cardCornerRadius="5dp"
                         android:layout_margin="5dp"
                         android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:animateLayoutChanges="true"
                        android:gravity="center"
                        app:strokeColor="@color/icon_dashdornd_tabel2_background"
                        app:cardBackgroundColor="@color/actionbar_text_color"
                        app:cardElevation="2dp"
                        app:cardMaxElevation="1dp"
                        android:translationZ="4dp"
                        app:strokeWidth="1dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/materialButtonОтправка"
                                android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="150dp"
                                android:layout_height="50dp"
                                android:layout_centerInParent="true"
                                 android:layout_marginTop="15dp"
                                android:layout_marginBottom="2dp"
                                android:padding="2dp"
                                android:backgroundTint="#FFFFFF"
                                android:backgroundTintMode="screen"
                                android:clickable="true"
                                android:focusable="auto"
                                android:fontFamily="sans-serif-medium"
                                android:foregroundGravity="center"
                                android:gravity="center"
                                android:scrollbarStyle="outsideInset"
                                android:text="Отправить"
                                android:textColor="#0E0E0E"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:typeface="normal"
                                android:visibility="visible"
                                app:cornerRadius="18dp"
                                app:strokeWidth="1dp" />

                        </RelativeLayout>

                    </com.google.android.material.card.MaterialCardView>


                </RelativeLayout>
            </TableRow>
        </TableLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>


