<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tableLayout_dashboard"
    android:shrinkColumns="*"
    android:stretchColumns="0"
    android:collapseColumns="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="top"
    android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
    tools:context=".CoreApp.Apps.BootAndAsyncApp.View.MainActivityBootAndAsync"
    tools:ignore="MissingClass">






    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|center_horizontal">
        <com.scwang.wave.MultiWaveHeader
            android:id="@+id/waveHeader"
            android:layout_width="match_parent"
            app:mwhStartColor="@color/colorPrimary"
            app:mwhCloseColor="@color/color_beliyi"
            app:mwhWaves="MultiWave"
            android:layout_height="70dp"/>
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|center_horizontal">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <!--   //TODO   #5 -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/imageview_to_settings"
                android:layout_width="50dp"
                android:layout_height="35dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_centerVertical="true"
                android:layout_margin="2dp"
                android:padding="1dp"
                android:backgroundTint="#FFFFFF"
                android:visibility="visible"
                app:rippleColor="@color/colorPrimaryDark"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:foreground="?attr/selectableItemBackground"
                app:srcCompat="@drawable/icon_new_dashaborad_settings" />

        </RelativeLayout>
    </TableRow>


    <!--//TODO   ROW#1-->
    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/disayn_line_tablerow6"
        android:gravity="center"
        android:layout_margin="2dp"
        android:padding="2dp"
        android:layout_gravity="center">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="1dp"
            android:gravity="center"
            android:background="#FFFFFF"
            app:layout_gravity="center"
            app:cardElevation="2dp"
            app:cardMaxElevation="10dp"
            android:translationZ="10dp"
            android:animateLayoutChanges="true"
            app:strokeColor="#F1ECEC"
            app:strokeWidth="0dp">



                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.viewpager2.widget.ViewPager2
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        android:id="@+id/pagerdachbord"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                         android:layout_centerInParent="true"
                        app:cardBackgroundColor="@color/divider" />
                </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </TableRow>


    <!--//TODO   ROW#2-->
    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/disayn_line_tablerow6"
        android:layout_gravity="center">


        <ScrollView
            android:id="@+id/nestedScrollViewApp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:fillViewport="true"
            android:scrollbars="horizontal|vertical"
            android:stackFromBottom="true"
            android:transcriptMode="alwaysScroll"
            android:drawingCacheQuality="auto"
            android:foregroundGravity="center_horizontal"
            android:orientation="horizontal"
            android:overScrollMode="always"
            android:background="#3EF3F3F4"
            android:scrollbarAlwaysDrawHorizontalTrack="true"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarStyle="outsideInset">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">




                <com.google.android.material.button.MaterialButton
                    android:id="@+id/КнопкаТабель"
                    style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                    android:layout_width="220dp"
                    android:layout_height="300dp"
                    android:layout_alignParentLeft="true"
                    android:layout_margin="5dp"
                    android:padding="10dp"
                    android:backgroundTint="#FFFFFF"
                    android:drawableLeft="@drawable/icon_tabel_dashbord"
                    android:fontFamily="@font/alfa_slab_one"
                    android:minHeight="70dp"
                    android:paddingLeft="10dp"
                    android:text="Табель"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:translationZ="3dp"
                    app:cardElevation="2dp"
                    app:cardMaxElevation="1dp"
                    app:cornerRadius="15dp"
                    app:iconGravity="textStart"
                    app:rippleColor="@color/design_default_color_on_secondary"
                    app:strokeColor="#EEEDEF"
                    app:strokeWidth="1dp" />





                <com.google.android.material.button.MaterialButton
                    android:id="@+id/КнопкаЗаявкаНаТранспорт"
                    style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="150dp"
                    android:layout_margin="5dp"
                    android:padding="10dp"
                    android:layout_toRightOf="@+id/КнопкаТабель"
                    android:backgroundTint="#FFFFFF"
                    android:drawableLeft="@drawable/icon_task_transport_dashbord"
                    android:fontFamily="@font/alfa_slab_one"
                    android:layout_alignParentRight="true"
                    android:minHeight="70dp"
                    android:paddingLeft="15dp"
                    android:text="Заявки на транспорт"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:translationZ="2dp"
                    android:visibility="visible"
                    app:cardElevation="2dp"
                    app:cardMaxElevation="1dp"
                    app:cornerRadius="15dp"
                    app:iconGravity="textStart"
                    app:rippleColor="@color/design_default_color_on_secondary"
                    app:strokeColor="#EEEDEF"
                    app:strokeWidth="1dp" />







            </RelativeLayout>

        </ScrollView>




    </TableRow>

</TableLayout>










