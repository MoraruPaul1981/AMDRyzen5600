<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:visibility="visible"
    android:orientation="horizontal"
    tools:context=".TabelsApp.Peoples.listpeoples.view.MainActivityListPeoples">







    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/materialtextviewincounttemplates"
        android:layout_width="50dp"
        android:layout_height="100dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="5dp"
        android:padding="2dp"
        android:background="@drawable/stylefortemplates1"
        android:gravity="center_vertical|center_horizontal"
        android:hint="()"
        android:textColor="#AFB2B5"
        android:textColorHint="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:translationZ="5dp"
        android:visibility="visible"
        app:cardCornerRadius="1dp"
        app:cardElevation="1dp"/>





                    <CheckedTextView
                        android:id="@+id/checkedtextviewtemplates"
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:textAlignment="gravity"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginEnd="5dp"
                        android:padding="2dp"
                        android:background="@drawable/stylefortemplates1"
                        android:checkMark="?android:attr/textCheckMarkInverse"
                        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        app:layout_gravity="center_horizontal"
                        android:visibility="visible"/>








</LinearLayout>











