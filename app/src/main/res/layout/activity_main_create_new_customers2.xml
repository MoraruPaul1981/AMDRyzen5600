<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/materialcardnwpeople"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="1dp"
    app:cardElevation="10dp"
    app:cardMaxElevation="10dp"
    android:layout_centerInParent="true"
    app:strokeWidth="0dp"
    android:translationZ="5dp"
    android:animateLayoutChanges="true"
    app:cardBackgroundColor="#EAE8E8"
    app:strokeColor="#EDEBEB"
    android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
    tools:context=".TabelsApp.Peoples.MainActivityNewPeople">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top"
        android:gravity="top"
        android:foregroundGravity="center"
        android:orientation="vertical">




        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialcardviewrow1"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_margin="5dp"
            android:padding="2dp"
            android:layout_gravity="top"
            android:foregroundGravity="top"
            android:animateLayoutChanges="true"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:translationZ="10dp"
            app:cardBackgroundColor="@color/actionbar_text_color"
            app:cardCornerRadius="5dp"
            app:cardElevation="5dp"
            app:cardMaxElevation="1dp"
            app:strokeColor="@color/icon_dashdornd_tabel2_background"
            app:strokeWidth="1dp">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:padding="2dp">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/imageViewСтрелкаНазадНовыйСотрудник"
                    android:layout_width="43dp"
                    android:layout_height="55dp"
                    android:layout_column="0"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:backgroundTint="#F1F4F4"
                    android:fontFamily="@font/alegreya_sans_sc_thin"
                    android:gravity="center"
                    android:padding="1dp"
                    android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                    android:textAlignment="center"
                    android:translationZ="5dp"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="2dp"
                    app:cardMaxElevation="20dp"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/icon_back_tabelcustomer_arrow"
                    app:iconGravity="textEnd"
                    app:iconPadding="1dp"
                    app:iconSize="20dp"
                    app:iconTint="#909393"
                    app:rippleColor="#F50057"
                    app:strokeColor="#E0E0E3"
                    app:strokeWidth="1dp"
                    tools:ignore="SpeakableTextPresentCheck" />

                <TextView
                    android:id="@+id/НазваниеСозданиеНовогоСотрудника"
                    style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="1dp"
                    android:bufferType="normal"
                    android:fontFamily="sans-serif-light"
                    android:foregroundGravity="center"
                    android:gravity="center"
                    android:padding="1dp"
                    android:text="Новый сотрудник"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="#0E0E0E"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:theme="@style/Theme.AppCompat.DayNight"
                    android:typeface="serif" />
            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>




        <!-- //TODO сам лист -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialcardViewrowscroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="5dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:padding="2dp"
            android:layout_gravity="center"
            android:animateLayoutChanges="true"
            android:gravity="center"
            app:strokeColor="@color/icon_dashdornd_tabel2_background"
            app:cardBackgroundColor="@color/actionbar_text_color"
            app:cardElevation="2dp"
            app:cardMaxElevation="1dp"
            android:translationZ="4dp"
            app:strokeWidth="0dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ScrollView
                    android:id="@+id/nestedScrollView_singlet"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:fillViewport="true"
                    android:scrollbars="horizontal|vertical"
                    android:stackFromBottom="true"
                    android:transcriptMode="alwaysScroll"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/disayn_line_tablerow5">

                         <!--//TODO  основные Компоненты -->
   <LinearLayout
       android:orientation="vertical"
       android:layout_gravity="center"
       android:gravity="center"
       android:foregroundGravity="top"
       android:layout_width="match_parent"
       android:layout_height="match_parent">


       <EditText
           android:id="@+id/ЗначениеЦФОПриСозданииНовогоТабеля"
           style="com.android.tools.property.panel.impl.model.TableGroupItem@7ad956ee
            com.android.tools.property.panel.impl.model.TableGroupItem@7ad956ee"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_margin="20dp"
           android:layout_marginTop="100dp"
           android:drawableLeft="@drawable/ic_baseline_directions_walk_24_new_people"
           android:gravity="center"
           android:hint="ФИО"
           android:inputType="textPersonName|textCapWords"
           android:lineSpacingExtra="15sp"
           android:textColor="@android:color/black"
           android:textColorHint="#675757"
           android:textSize="12sp"
           android:textStyle="bold"
           android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar"
           android:visibility="visible" />

       <TextView
           android:id="@+id/ЗначениеДепартаментаПриСоздаенииНовогоТабеля"
           style="@style/Widget.AppCompat.EditText"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_margin="20dp"
           android:layout_marginTop="10dp"
           android:layout_marginBottom="200dp"
           android:drawableLeft="@drawable/ic_baseline_event_24_new_calendar_new_peple"
           android:gravity="center"
           android:hint="ДАТА РОЖДЕНИЯ"
           android:inputType="date"
           android:textColor="@android:color/black"
           android:textColorHint="#675757"
           android:textSize="12sp"
           android:textStyle="bold"
           android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar"
           android:visibility="visible" />

       <EditText
           android:id="@+id/ЗначениеДатаСоздаваемогоТабеля"
           style="@style/Widget.AppCompat.EditText"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_margin="20dp"
           android:layout_marginTop="10dp"
           android:layout_marginBottom="150dp"
           android:drawableLeft="@drawable/ic_baseline_filter_1_24_new_snils_new_people"
           android:gravity="center"
           android:hint="СНИЛС ( 11 символов)"
           android:inputType="number"
           android:lineSpacingExtra="15sp"
           android:textColor="@android:color/black"
           android:textColorHint="#675757"
           android:textSize="12sp"
           android:textStyle="bold"
           android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar"
           android:visibility="visible"/>




       <Spinner
           android:id="@+id/значениеИзСпинераОрганизацияДляНовогоСотрудника"
           style="@android:style/Widget.Holo.Light.Spinner"
           android:layout_width="match_parent"
           android:layout_height="40dp"
           android:layout_marginStart="20dp"
           android:layout_marginTop="20dp"
           android:layout_marginEnd="20dp"
           android:layout_marginBottom="80dp"
           android:backgroundTintMode="multiply"
           android:dropDownWidth="wrap_content"
           android:ellipsize="none"
           android:gravity="center|center_horizontal"
           android:inputType="textMultiLine"
           android:lines="2"
           android:maxLines="50"
           android:scrollHorizontally="false"
           android:singleLine="false"
           android:spinnerMode="dropdown"
           android:textColor="#0E0E0E"
           android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar"
           android:visibility="visible" />
   </LinearLayout>









                </ScrollView>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>














        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialcardViewlastrow"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            app:cardCornerRadius="5dp"
            android:layout_margin="5dp"
            android:padding="2dp"
            android:layout_gravity="bottom"
            android:foregroundGravity="bottom"
            android:animateLayoutChanges="true"
            android:gravity="center"
            app:cardBackgroundColor="@color/actionbar_text_color"
            app:strokeColor="@color/icon_dashdornd_tabel2_background"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            app:cardElevation="2dp"
            app:cardMaxElevation="1dp"
            android:translationZ="4dp"
            app:strokeWidth="0dp">



            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/КнопкаСозданиеНовогоТабеля"
                    android:layout_width="150dp"
                    android:layout_height="50dp"
                    android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:backgroundTint="#FFD5D9DA"
                    android:gravity="center"
                    android:foregroundGravity="center"
                    android:layout_centerInParent="true"
                    android:text="Создать"
                    android:textAlignment="center"
                    android:textAllCaps="true"
                    android:textColor="#100F10"
                    android:textColorHint="#F50057"
                    android:textSize="12dp"
                    android:visibility="visible"
                    app:cornerRadius="16dp"
                    app:iconTint="#8A3C3C"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:rippleColor="@color/colorAccent"
                    app:strokeColor="#FF3D00"
                    tools:visibility="visible" />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>




    </LinearLayout>

</com.google.android.material.card.MaterialCardView>



